# Copie este archivo como secrets.toml únicamente en un entorno local seguro.
# Nunca añada secrets.toml al control de versiones.

# Live permanece bloqueado mientras este valor no sea true. Un parámetro URL
# `modo=live` no puede sustituir esta autorización del servidor.
LIVE_ENABLED = false

# Use como mínimo 32 bytes aleatorios y congele la versión durante un estudio.
HMAC_SECRET = "REEMPLACE_POR_UN_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS"
HMAC_VERSION = "v1"

# Formato: pbkdf2_sha256$iteraciones$salt_hex$digest_hex
DOCENTE_PASSWORD_HASH = "pbkdf2_sha256$600000$REEMPLACE_SALT_HEX$REEMPLACE_DIGEST_HEX"

# Solo para una recogida live aprobada.
PROLIFIC_COMPLETION_URL = "https://app.prolific.com/submissions/complete?cc=REEMPLACE_CODIGO"
SUPPORT_EMAIL = "soporte-institucional@example.org"

# La ruta local predeterminada es únicamente para demo. En live, la aplicación
# exige una ruta absoluta externa al directorio del código.
DATABASE_PATH = "data/respuestas_recibidas.sqlite3"

# Opcionales para completar los textos institucionales.
INSTITUTION_NAME = "REEMPLACE_INSTITUCION"
ETHICS_REFERENCE = "REEMPLACE_REFERENCIA_ETICA"
